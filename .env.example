# ===== 项目环境变量示例 =====
# 使用方法：把本文件复制一份为 .env，再填入真实值。
# 铁律：.env 放在 .gitignore 里，绝不能提交到 git。
# 如果你用 git，确保下面这行存在于 .gitignore：
#   .env

# ---- 示例配置（照抄结构，按需增删）----

# 数据库连接串
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# 第三方服务密钥（只放这里，代码里用环境变量读取，不要写死在源码）
# API_KEY=your_api_key_here

# 服务端口
# PORT=8080

# 运行环境：development | production
# NODE_ENV=development
