# ===== 项目环境变量示例 =====
# 使用方法：把本文件复制一份为 .env，再填入真实值。
# 铁律：.env 放在 .gitignore 里，绝不能提交到 git。
#
# 本项目是「零外部依赖」的 Node 服务（只用 Node 内置模块），启动方式：
#   node server/server.mjs
# systemd 部署时把下面变量写进 service 的 Environment= 里。

# ---- 服务监听 ----
# 监听端口（默认 8080）
PORT=8080
# 监听地址（默认 0.0.0.0 = 允许外部访问；若用 Nginx 反代可设 127.0.0.1）
HOST=0.0.0.0

# ---- 注册口令（重要）----
# 注册新账号时必须提供，防止陌生人在公网上注册。
# 不设置时默认 "ask-owner"（仅适合本地测试，请务必修改）。
REGISTER_CODE=change-me-to-a-strong-code

# ---- 数据库 ----
# SQLite 数据库文件路径（默认 <项目>/var/learning.db）
# 生产环境建议指向独立可写目录，便于备份与持久化。
DB_PATH=/var/lib/random-question/learning.db
